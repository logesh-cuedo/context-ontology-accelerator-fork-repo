{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": "dynamodb:DescribeTable",
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Action": [
        "neptune-db:ReadDataViaQuery",
        "neptune-db:GetQueryStatus"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:neptune-db:${Region}:${AccountId}:arn:aws:rds:${Region}:${AccountId}:cluster:coa-dev-*/*"
    },
    {
      "Action": "aoss:BatchGetCollection",
      "Effect": "Allow",
      "Resource": "*"
    }
  ]
}
