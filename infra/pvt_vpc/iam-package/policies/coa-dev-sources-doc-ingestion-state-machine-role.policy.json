{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": "dynamodb:UpdateItem",
      "Effect": "Allow",
      "Resource": "arn:aws:dynamodb:${Region}:${AccountId}:table/arn:aws:dynamodb:${Region}:${AccountId}:table/coa-dev-*"
    },
    {
      "Action": "lambda:InvokeFunction",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:lambda:${Region}:${AccountId}:function:coa-dev-*",
        "arn:aws:lambda:${Region}:${AccountId}:function:coa-dev-*:*"
      ]
    },
    {
      "Action": "ecs:RunTask",
      "Effect": "Allow",
      "Resource": "arn:aws:ecs:${Region}:${AccountId}:task-definition/coa-dev-*:*"
    },
    {
      "Action": [
        "ecs:StopTask",
        "ecs:DescribeTasks"
      ],
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Action": "iam:PassRole",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:iam::${AccountId}:role/coa-dev-*",
        "arn:aws:iam::${AccountId}:role/coa-dev-*"
      ]
    },
    {
      "Action": [
        "events:PutTargets",
        "events:PutRule",
        "events:DescribeRule"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:events:${Region}:${AccountId}:rule/StepFunctionsGetEventsForECSTaskRule"
    }
  ]
}
