{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::coa-dev-*/*"
    },
    {
      "Action": [
        "neptune-db:ReadDataViaQuery",
        "neptune-db:WriteDataViaQuery",
        "neptune-db:DeleteDataViaQuery"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:neptune-db:${Region}:${AccountId}:arn:aws:rds:${Region}:${AccountId}:cluster:coa-dev-*/*"
    },
    {
      "Action": "aoss:APIAccessAll",
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:${Region}:${AccountId}:parameter/*"
    },
    {
      "Action": "bedrock:InvokeModel",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:bedrock:*:${AccountId}:inference-profile/us.cohere.embed-v4:0",
        "arn:aws:bedrock:*::foundation-model/*"
      ]
    },
    {
      "Action": "events:PutEvents",
      "Effect": "Allow",
      "Resource": "arn:aws:events:${Region}:${AccountId}:event-bus/default"
    },
    {
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:ConditionCheckItem",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/arn:aws:ssm:${Region}:${AccountId}:parameter/*"
      ]
    },
    {
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/arn:aws:ssm:${Region}:${AccountId}:parameter/*"
      ]
    },
    {
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:ConditionCheckItem",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/arn:aws:ssm:${Region}:${AccountId}:parameter/*"
      ]
    },
    {
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/arn:aws:ssm:${Region}:${AccountId}:parameter/*"
      ]
    },
    {
      "Action": "sts:AssumeRole",
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:${Region}:${AccountId}:parameter/*"
    },
    {
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:ConditionCheckItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-dev-*"
      ]
    },
    {
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-dev-*"
      ]
    },
    {
      "Action": [
        "sqs:SendMessage",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:sqs:${Region}:${AccountId}:coa-dev-*"
    }
  ]
}
