            "iam:PassedToService": "datazone.amazonaws.com"
          }
        },
        "Effect": "Allow",
        "Resource": "arn:aws:iam::${AccountId}:role/coa-dev-smus-exec",
        "Sid": "IAMPassRoleStatement"
      }
    ]
  },
  "statementCount": 1
