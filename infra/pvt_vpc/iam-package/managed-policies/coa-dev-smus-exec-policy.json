{
  "managedPolicyName": "coa-dev-smus-exec-policy",
  "type": "AWS::IAM::ManagedPolicy",
  "stack": "coa-dev-namespace",
  "logicalId": "SMUSExecutionPolicy75052919",
  "description": "Scoped permissions for SMUS domain execution role",
  "attachedToRole": "coa-dev-smus-exec",
  "policyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Action": [
          "datazone:CreateDomain",
          "datazone:GetDomain",
          "datazone:UpdateDomain",
          "datazone:DeleteDomain",
          "datazone:ListDomains",
          "datazone:CreateProject",
          "datazone:GetProject",
          "datazone:UpdateProject",
          "datazone:DeleteProject",
          "datazone:CreateEnvironment",
          "datazone:GetEnvironment",
          "datazone:UpdateEnvironment",
          "datazone:DeleteEnvironment"
        ],
        "Effect": "Allow",
        "Resource": "*"
      },
      {
        "Action": [
          "sagemaker:CreateDomain",
          "sagemaker:DescribeDomain",
          "sagemaker:UpdateDomain",
          "sagemaker:DeleteDomain",
          "sagemaker:CreateUserProfile",
          "sagemaker:DescribeUserProfile",
          "sagemaker:UpdateUserProfile",
          "sagemaker:DeleteUserProfile",
          "sagemaker:CreateSpace",
          "sagemaker:DescribeSpace",
          "sagemaker:UpdateSpace",
          "sagemaker:DeleteSpace"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:sagemaker:${Region}:${AccountId}:domain/*",
          "arn:aws:sagemaker:${Region}:${AccountId}:user-profile/*",
          "arn:aws:sagemaker:${Region}:${AccountId}:space/*"
        ]
      },
      {
        "Action": [
          "glue:CreateDatabase",
          "glue:GetDatabase",
          "glue:UpdateDatabase",
          "glue:DeleteDatabase",
          "glue:CreateTable",
          "glue:GetTable",
          "glue:UpdateTable",
          "glue:DeleteTable",
          "glue:GetTables"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:glue:${Region}:${AccountId}:catalog",
          "arn:aws:glue:${Region}:${AccountId}:database/*",
          "arn:aws:glue:${Region}:${AccountId}:table/*"
        ]
      },
      {
        "Action": [
          "lakeformation:GrantPermissions",
          "lakeformation:RevokePermissions",
          "lakeformation:GetDataAccess",
          "lakeformation:ListPermissions"
        ],
        "Effect": "Allow",
        "Resource": "*"
      },
      {
        "Action": [
          "athena:StartQueryExecution",
          "athena:GetQueryExecution",
          "athena:GetQueryResults",
          "athena:StopQueryExecution"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:athena:${Region}:${AccountId}:workgroup/*"
      },
      {
        "Action": [
          "redshift:DescribeClusters",
          "redshift:GetClusterCredentials"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:redshift:${Region}:${AccountId}:cluster:*"
      },
      {
        "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject",
          "s3:ListBucket"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:s3:::coa-dev-*",
          "arn:aws:s3:::coa-dev-*/*"
        ]
      },
      {
        "Action": [
          "iam:GetRole",
          "iam:PassRole",
          "iam:ListRolePolicies",
          "iam:GetRolePolicy"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:iam::${AccountId}:role/coa-dev-*"
      },
      {
        "Action": [
          "scheduler:CreateSchedule",
          "scheduler:GetSchedule",
          "scheduler:UpdateSchedule",
          "scheduler:DeleteSchedule"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:scheduler:${Region}:${AccountId}:schedule/*"
      },
      {
        "Action": [
          "bedrock:CreateAgent",
          "bedrock:GetAgent",
          "bedrock:UpdateAgent",
          "bedrock:DeleteAgent",
          "bedrock:InvokeAgent",
          "bedrock:CreateKnowledgeBase",
          "bedrock:GetKnowledgeBase",
          "bedrock:UpdateKnowledgeBase",
          "bedrock:DeleteKnowledgeBase"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:bedrock:${Region}:${AccountId}:agent/*",
          "arn:aws:bedrock:${Region}:${AccountId}:knowledge-base/*"
        ]
      },
      {
        "Action": [
          "emr-serverless:CreateApplication",
          "emr-serverless:GetApplication",
          "emr-serverless:UpdateApplication",
          "emr-serverless:DeleteApplication",
          "emr-serverless:StartJobRun",
          "emr-serverless:GetJobRun",
          "emr-serverless:CancelJobRun"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:emr-serverless:${Region}:${AccountId}:/applications/*"
      },
      {
        "Action": [
          "airflow:GetEnvironment",
          "airflow:CreateEnvironment",
          "airflow:UpdateEnvironment",
          "airflow:DeleteEnvironment"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:airflow:${Region}:${AccountId}:environment/*"
      }
    ]
  },
  "statementCount": 12
}
