{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheTwentyThreeServicesTheStacksCreateResourcesIn",
      "Effect": "Allow",
      "Action": [
        "apigateway:*",
        "athena:*",
        "aoss:*",
        "bedrock:*",
        "bedrock-agentcore:*",
        "cloudformation:*",
        "cloudfront:*",
        "cloudwatch:*",
        "cognito-idp:*",
        "datazone:*",
        "dynamodb:*",
        "ecs:*",
        "events:*",
        "lambda:*",
        "logs:*",
        "rds:*",
        "s3:*",
        "scheduler:*",
        "servicediscovery:*",
        "sqs:*",
        "ssm:*",
        "states:*",
        "wafv2:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AttachThePreCreatedRolesAndReadThemBack",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iam:GetRole",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "ec2:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CannotBeUndoneByAnyPolicyAttachedLater",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:CreatePolicy",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "*"
    }
  ]
}
