{
  "roleName": "cdk-hnb659fds-file-publishing-role-${AccountId}-${Region}",
  "stack": "CDKToolkit",
  "logicalId": "FilePublishingRole",
  "nameIsExplicit": true,
  "description": "CDK bootstrap: uploads file assets to the staging bucket",
  "trustPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Action": "sts:AssumeRole",
        "Effect": "Allow",
        "Principal": {
          "AWS": "${AccountId}"
        }
      },
      {
        "Action": "sts:TagSession",
        "Effect": "Allow",
        "Principal": {
          "AWS": "${AccountId}"
        }
      }
    ]
  },
  "managedPolicyArns": [],
  "inlinePolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Action": [
          "s3:GetObject*",
          "s3:GetBucket*",
          "s3:GetEncryptionConfiguration",
          "s3:List*",
          "s3:DeleteObject*",
          "s3:PutObject*",
          "s3:Abort*"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:s3:::cdk-hnb659fds-assets-${AccountId}-${Region}",
          "arn:aws:s3:::cdk-hnb659fds-assets-${AccountId}-${Region}/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceAccount": ["${AccountId}"]
          }
        }
      },
      {
        "Action": [
          "kms:Decrypt",
          "kms:DescribeKey",
          "kms:Encrypt",
          "kms:ReEncrypt*",
          "kms:GenerateDataKey*"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:kms:${Region}:${AccountId}:key/*",
        "Condition": {
          "StringEquals": {
            "kms:ViaService": "s3.${Region}.amazonaws.com"
          }
        }
      }
    ]
  },
  "statementCount": 2
}
