{
  "managedPolicyName": "coa-test-dev-cfn-exec-policy",
  "type": "AWS::IAM::ManagedPolicy",
  "purpose": "Pass as CloudFormationExecutionPolicies when applying coa-cdk-bootstrap.yaml. Replaces that parameter default, which is AdministratorAccess.",
  "attachedToRole": "cdk-hnb659fds-cfn-exec-role-<account>-<region>",
  "notAttachedToTheApplicationRoles": true,
  "whyTheDenyIsNotRedundant": "IAM denies by default, so the omitted actions are already refused. The explicit Deny survives a broader policy being attached to the same role later - CloudFormationExecutionPolicies takes a LIST, and its default value is AdministratorAccess.",
  "policyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "TheTwentyThreeServicesTheStacksCreateResourcesIn",
        "Effect": "Allow",
        "Action": [
          "aoss:*",
          "apigateway:*",
          "athena:*",
          "bedrock-agentcore:*",
          "bedrock:*",
          "cloudformation:*",
          "cloudfront:*",
          "cloudwatch:*",
          "cognito-idp:*",
          "datazone:*",
          "dynamodb:*",
          "ecs:*",
          "events:*",
          "lambda:*",
          "logs:*",
          "rds:*",
          "route53:AssociateVPCWithHostedZone",
          "route53:ChangeResourceRecordSets",
          "route53:ChangeTagsForResource",
          "route53:CreateHostedZone",
          "route53:DeleteHostedZone",
          "route53:DisassociateVPCFromHostedZone",
          "route53:GetChange",
          "route53:GetHostedZone",
          "route53:ListHostedZonesByName",
          "route53:ListHostedZonesByVPC",
          "route53:ListResourceRecordSets",
          "route53:ListTagsForResource",
          "s3:*",
          "scheduler:*",
          "servicediscovery:*",
          "sqs:*",
          "ssm:*",
          "states:*",
          "wafv2:*"
        ],
        "Resource": "*"
      },
      {
        "Sid": "AttachThePreCreatedRolesAndReadThemBack",
        "Effect": "Allow",
        "Action": [
          "iam:PassRole",
          "iam:GetRole",
          "iam:GetPolicy",
          "iam:GetPolicyVersion",
          "iam:ListRolePolicies",
          "iam:ListAttachedRolePolicies",
          "iam:TagRole",
          "ec2:Describe*"
        ],
        "Resource": "*"
      },
      {
        "Sid": "CannotBeUndoneByAnyPolicyAttachedLater",
        "Effect": "Deny",
        "Action": [
          "iam:CreateRole",
          "iam:CreatePolicy",
          "iam:PutRolePolicy",
          "iam:AttachRolePolicy",
          "iam:UpdateAssumeRolePolicy",
          "ec2:CreateSecurityGroup",
          "ec2:AuthorizeSecurityGroupIngress",
          "ec2:AuthorizeSecurityGroupEgress",
          "ec2:CreateVpcEndpoint"
        ],
        "Resource": "*"
      }
    ]
  }
}
