{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:ConditionCheckItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*",
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*/index/*"
      ]
    },
    {
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*",
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*/index/*"
      ]
    },
    {
      "Action": [
        "s3:GetObject*",
        "s3:GetBucket*",
        "s3:List*",
        "s3:DeleteObject*",
        "s3:PutObject",
        "s3:PutObjectLegalHold",
        "s3:PutObjectRetention",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionTagging",
        "s3:Abort*"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::coa-test-dev-*",
        "arn:aws:s3:::coa-test-dev-*/*"
      ]
    },
    {
      "Action": "sts:AssumeRole",
      "Effect": "Allow",
      "Resource": "arn:aws:iam::${AccountId}:role/coa-test-dev-*"
    },
    {
      "Action": [
        "glue:CreateConnection",
        "glue:DeleteConnection",
        "glue:GetConnection",
        "glue:UpdateConnection",
        "glue:PassConnection"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:glue:${Region}:${AccountId}:catalog",
        "arn:aws:glue:${Region}:${AccountId}:connection/coadevds_*"
      ],
      "Sid": "GlueConnectionManagement"
    },
    {
      "Action": [
        "glue:CreateCatalog",
        "glue:DeleteCatalog",
        "glue:GetCatalog",
        "glue:GetDatabase"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:glue:${Region}:${AccountId}:catalog",
        "arn:aws:glue:${Region}:${AccountId}:catalog/coadevds_*",
        "arn:aws:glue:${Region}:${AccountId}:database/coadevds_*/*"
      ],
      "Sid": "GlueFederatedCatalogManagement"
    },
    {
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:glue:${Region}:${AccountId}:catalog",
        "arn:aws:glue:${Region}:${AccountId}:catalog/coadevds_*",
        "arn:aws:glue:${Region}:${AccountId}:database/coadevds_*",
        "arn:aws:glue:${Region}:${AccountId}:table/coadevds_*"
      ],
      "Sid": "GlueFederatedCatalogRead"
    },
    {
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetTags"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:glue:${Region}:${AccountId}:catalog",
        "arn:aws:glue:${Region}:${AccountId}:database/*",
        "arn:aws:glue:${Region}:${AccountId}:table/*/*"
      ],
      "Sid": "GlueNativeDatabaseRead"
    },
    {
      "Action": [
        "lakeformation:RegisterResource",
        "lakeformation:DeregisterResource",
        "lakeformation:DescribeResource",
        "lakeformation:GrantPermissions"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "LakeFormationFederation"
    },
    {
      "Action": "ssm:GetParameter",
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:${Region}:${AccountId}:parameter/coa-test/dev/serve/runtime-role-arn",
      "Sid": "ReadConsumerQueryRoleParam"
    },
    {
      "Action": [
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:PutResourcePolicy"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${AccountId}"
        },
        "Null": {
          "secretsmanager:ResourceTag/coa:namespace": "false"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:*:*:secret:*",
      "Sid": "SecretResourcePolicyForConsumer"
    },
    {
      "Action": "secretsmanager:DescribeSecret",
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:*:${AccountId}:secret:*",
      "Sid": "DescribeSecretForNamespaceBinding"
    },
    {
      "Action": "iam:PassRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "glue.amazonaws.com",
            "lakeformation.amazonaws.com"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::${AccountId}:role/coa-test-dev-*",
      "Sid": "PassFederatedCatalogRole"
    },
    {
      "Action": "iam:GetRole",
      "Effect": "Allow",
      "Resource": "arn:aws:iam::${AccountId}:role/coa-test-dev-*",
      "Sid": "GetFederatedCatalogRole"
    }
  ]
}
