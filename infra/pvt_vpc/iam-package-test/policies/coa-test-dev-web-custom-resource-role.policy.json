{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": "cognito-idp:UpdateUserPoolClient",
      "Effect": "Allow",
      "Resource": "arn:aws:cognito-idp:${Region}:${AccountId}:userpool/*"
    },
    {
      "Action": [
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:POST"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:apigateway:${Region}::/restapis/*"
    },
    {
      "Action": [
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:POST"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:apigateway:${Region}::/restapis/*"
    },
    {
      "Action": "apigateway:POST",
      "Effect": "Allow",
      "Resource": "arn:aws:apigateway:${Region}::/restapis/*"
    },
    {
      "Action": "ssm:GetParameter",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ssm:us-east-1:${AccountId}:parameter/coa-test/edge/cloudfront-web-acl-arn"
      ]
    }
  ]
}
