{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": "lambda:InvokeFunction",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:lambda:${Region}:${AccountId}:function:coa-test-dev-*",
        "arn:aws:lambda:${Region}:${AccountId}:function:coa-test-dev-*:*"
      ]
    },
    {
      "Action": "lambda:GetFunction",
      "Effect": "Allow",
      "Resource": "arn:aws:lambda:${Region}:${AccountId}:function:coa-test-dev-*"
    }
  ]
}
