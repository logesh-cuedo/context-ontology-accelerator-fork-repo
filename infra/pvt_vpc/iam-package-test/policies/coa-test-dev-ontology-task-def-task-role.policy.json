{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "neptune-db:ReadDataViaQuery",
        "neptune-db:WriteDataViaQuery",
        "neptune-db:DeleteDataViaQuery",
        "neptune-db:GetQueryStatus",
        "neptune-db:CancelQuery"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:neptune-db:${Region}:${AccountId}:arn:aws:rds:${Region}:${AccountId}:cluster:coa-test-dev-*/*"
    },
    {
      "Action": "aoss:APIAccessAll",
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:${Region}:${AccountId}:parameter/*"
    },
    {
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:ConditionCheckItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*"
      ]
    },
    {
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*"
      ]
    },
    {
      "Action": [
        "s3:GetObject*",
        "s3:GetBucket*",
        "s3:List*",
        "s3:DeleteObject*",
        "s3:PutObject",
        "s3:PutObjectLegalHold",
        "s3:PutObjectRetention",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionTagging",
        "s3:Abort*"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::coa-test-dev-*",
        "arn:aws:s3:::coa-test-dev-*/*"
      ]
    },
    {
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:ConditionCheckItem",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/arn:aws:ssm:${Region}:${AccountId}:parameter/*"
      ]
    },
    {
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/arn:aws:ssm:${Region}:${AccountId}:parameter/*"
      ]
    },
    {
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:ConditionCheckItem",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/arn:aws:ssm:${Region}:${AccountId}:parameter/*"
      ]
    },
    {
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/arn:aws:ssm:${Region}:${AccountId}:parameter/*"
      ]
    },
    {
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ApplyGuardrail"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:${AccountId}:inference-profile/*",
        "arn:aws:bedrock:${Region}:${AccountId}:guardrail/*"
      ]
    },
    {
      "Action": [
        "aws-marketplace:ViewSubscriptions",
        "aws-marketplace:Subscribe"
      ],
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Action": "ssm:GetParameter",
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:${Region}:${AccountId}:parameter/coa-test/bedrock/guardrail-id"
    },
    {
      "Action": [
        "datazone:GetAsset",
        "datazone:SearchAssets",
        "datazone:Search",
        "datazone:GetProject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:datazone:${Region}:${AccountId}:domain/*",
        "arn:aws:datazone:${Region}:${AccountId}:domain/*/*"
      ]
    },
    {
      "Action": "sts:AssumeRole",
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:${Region}:${AccountId}:parameter/*"
    },
    {
      "Action": "lambda:InvokeFunction",
      "Effect": "Allow",
      "Resource": "arn:aws:lambda:${Region}:${AccountId}:function:coa-test-dev-sources-api"
    },
    {
      "Action": "events:PutEvents",
      "Effect": "Allow",
      "Resource": "arn:aws:events:${Region}:${AccountId}:event-bus/default"
    },
    {
      "Action": "cloudwatch:PutMetricData",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": [
            "COA/Ontology",
            "COA/Guardrails"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "*"
    }
  ]
}
