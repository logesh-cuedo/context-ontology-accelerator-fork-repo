{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:ConditionCheckItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*",
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*/index/*"
      ]
    },
    {
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*",
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*/index/*"
      ]
    },
    {
      "Action": "s3:DeleteObject*",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::coa-test-dev-*/*"
    },
    {
      "Action": [
        "s3:GetObject*",
        "s3:GetBucket*",
        "s3:List*"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::coa-test-dev-*",
        "arn:aws:s3:::coa-test-dev-*/*"
      ]
    }
  ]
}
