        "arn:aws:ssm:${Region}:${AccountId}:parameter/coa-test/smus/*",
        "arn:aws:ssm:${Region}:${AccountId}:parameter/coa-test/query/*"
      ]
    },
    {
      "Action": [
        "athena:CreateWorkGroup",
        "athena:GetWorkGroup",
        "athena:TagResource"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:athena:${Region}:${AccountId}:workgroup/coa-test-dev-*"
    },
    {
      "Action": [
        "ecs:DescribeServices",
        "ecs:ListTasks",
        "ecs:DescribeTasks"
      ],
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:${Region}:${AccountId}:cluster/coa-test-dev-*"
        }
      },
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Action": "states:StartExecution",
      "Effect": "Allow",
      "Resource": "arn:aws:states:${Region}:${AccountId}:stateMachine:coa-test-dev-*"
    }
  ]
