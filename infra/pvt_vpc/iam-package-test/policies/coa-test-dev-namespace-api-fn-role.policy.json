        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-metric-import-jobs"
      ]
    },
    {
      "Action": "dynamodb:TransactWriteItems",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*",
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*",
        "arn:aws:dynamodb:${Region}:${AccountId}:table/coa-test-dev-*"
      ]
    },
    {
      "Action": [
        "datazone:CreateProject",
        "datazone:CreateProjectMembership",
        "datazone:DeleteProject"
      ],
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Action": "iam:GetRole",
      "Effect": "Allow",
      "Resource": "arn:aws:iam::${AccountId}:role/coa-test-dev-*"
    },
    {
      "Action": "ssm:GetParameter",
      "Effect": "Allow",
